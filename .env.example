# ID Agents Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Authentication (choose one approach)
# ===========================================

# Option 1: Anthropic API Key (pay-per-use)
# Get your key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option 2: Claude Max Plan (unlimited usage)
# Run `claude login` first, then agents use your local session

# ===========================================
# Optional: Database
# ===========================================

# PostgreSQL connection (enables persistent news feeds, queries, teams)
# DATABASE_URL=postgresql://user:pass@localhost:5432/id_agents

# ===========================================
# Optional: Security
# ===========================================

# Admin API key for /remote endpoint and /keys management
# ID_CONTROL_API_KEY=your-secure-admin-key

# Inter-agent communication key
# ID_AGENT_API_KEY=your-agent-key

# ===========================================
# Optional: Task Brief Validation
# ===========================================

# Controls whether tasks require a valid brief (goal_id, expected_output,
# acceptance_criteria, validation_path, out_of_scope, backlog_policy, bittrees_relevance).
# off    = validation disabled
# warn   = validates and attaches metadata but never blocks (default)
# enforce = blocks task creation/claim/completion unless brief is complete
# ID_TASK_BRIEF_VALIDATION=enforce

# ===========================================
# Optional: Runtime Pressure Guards
# ===========================================

# Maximum active queries (pending + processing) allowed per non-lead worker
# before /ask is rejected. Configured team leads do not inherit this worker cap.
# Set 0 to disable the worker cap as well.
# ID_MAX_ACTIVE_QUERIES_PER_AGENT=3

# Optional lead-specific caps. Unset or 0 lets leads run unbounded concurrent
# sessions, each isolated by its caller session_id/context window.
# ID_AGENT_LEAD_QUERY_CONCURRENCY=0
# ID_MAX_ACTIVE_QUERIES_PER_LEAD=0

# Pending asks are expired quickly because they have not started running yet.
# Processing work keeps a longer default to allow legitimate long-running tasks.
# ID_PENDING_QUERY_EXPIRY_MINUTES=15
# ID_PROCESSING_QUERY_EXPIRY_MINUTES=120

# ===========================================
# Optional: Model Configuration
# ===========================================

# Default Claude model for agents
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ===========================================
# Optional: Public URL
# ===========================================

# Public URL base for agents (when exposing agents externally)
# PUBLIC_BASE_URL=https://idbot.live

# ===========================================
# Optional: Blockchain Integration
# ===========================================

# RPC URL for onchain agent registration
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key

# Agent registry contract address
# AGENT_REGISTRY_ADDRESS=0x...

# Registrar private key (for minting agent NFTs)
# ID_REGISTRAR_PRIVATE_KEY=0x...

# ===========================================
# Optional: SkillMesh Provider HD Key Derivation
# ===========================================

# SkillMesh is a bundled optional provider, not an id-agents core requirement.
# Master private key used to derive unique Ethereum keys for SkillMesh-enabled agents.
# Neutral agents never receive a SkillMesh key by default, even when this key is present.
# Each SkillMesh-enabled agent receives a key at m/44'/60'/0'/0/<index> when spawned.
# Set this to the same value as SKILL_MASTER_PRIVATE_KEY in the SkillMesh project.
# ID_AGENTS_SKILLMESH_AUTO_KEYS=true
# SKILLMESH_MASTER_KEY=0x...
